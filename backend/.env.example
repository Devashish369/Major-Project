# Same keys as backend/.env – all secret values are intentionally empty.
# Copy this file to .env and fill in real values before running.

# Development (default): a local SQLite file. Deployment: change ONLY this line, e.g.
#   DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require     (Neon / Supabase / Render)
# `postgres://` and `postgresql://` both work; the app picks the psycopg 3 driver itself.
DATABASE_URL=sqlite:///./intellipm.db
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
# (the app refuses to start on PostgreSQL with the placeholder below)
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
ACCESS_TOKEN_EXPIRE_MINUTES=720
# Comma-separated browser origins allowed to call the API. In deployment: your frontend URL, no trailing slash.
CORS_ORIGINS=http://localhost:5173
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=gemini-flash-latest
USE_CACHED_PLAN_ONLY=false
HOURS_PER_STORY_POINT=3
